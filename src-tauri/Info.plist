<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the bundle's Info.plist by `tauri build`. The app is Japanese only, so the
     bundle says so: macOS then draws its own menus in the WebView (the right-click menu's
     Cut, Copy, Paste and so on) in Japanese instead of English (#598). -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ja</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ja</string>
	</array>
</dict>
</plist>
