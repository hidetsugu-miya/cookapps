{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cookapps",
  "version": "0.16.3",
  "identifier": "jp.mysis.cookapps",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run build:ts && npm run watch:ts",
    "beforeBuildCommand": "npm run build:ts"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'self'"
    },
    "windows": [
      { "title": "cookapps", "width": 1200, "height": 820 }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBOUI0NzFERDRFOEI1ODcKUldTSHRlalVIVWViMmxza2xJcTJSVUc5YTUvNDVPLzNrSXA4OTVUMWFCbVJkbXhsdXFyUXFCblYK",
      "endpoints": ["https://github.com/hidetsugu-miya/cookapps/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
