{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cookup",
  "version": "0.13.2",
  "identifier": "jp.mysis.cookup",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'self'"
    },
    "windows": [
      { "title": "cookup", "width": 1200, "height": 820 }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
