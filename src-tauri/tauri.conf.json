{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tsunagiai",
  "identifier": "jp.mysis.tsunagiai",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run build:ts && npm run watch:ts",
    "beforeBuildCommand": "npm run build:ts"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'self' http://127.0.0.1:*"
    },
    "windows": [
      { "title": "つなぎAI", "width": 1200, "height": 820, "dragDropEnabled": false, "titleBarStyle": "Overlay", "hiddenTitle": true, "trafficLightPosition": { "x": 9, "y": 20 } }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBOUI0NzFERDRFOEI1ODcKUldTSHRlalVIVWViMmxza2xJcTJSVUc5YTUvNDVPLzNrSXA4OTVUMWFCbVJkbXhsdXFyUXFCblYK",
      "endpoints": ["https://github.com/hidetsugu-miya/tsunagiai/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "files": { "Resources/ja.lproj/InfoPlist.strings": "macos/ja.lproj/InfoPlist.strings" }
    }
  }
}
